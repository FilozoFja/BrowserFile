@model BrowserFile.Models.ViewModels.PublicFileViewModel;
@{
    ViewData["Title"] = "Pobieranie pliku";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css">

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>

<style>
    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .download-container {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 48px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.2);
        max-width: 480px;
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.3);
        margin: 0 auto;
        margin-top: 10vh;
    }

    .file-icon-container {
        width: 80px;
        height: 80px;
        margin: 0 auto 24px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 25px rgba(99, 102, 241, 0.3);
    }

    .file-icon-container i {
        color: white;
        font-size: 40px;
    }

    .download-title {
        font-size: 28px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 8px;
        letter-spacing: -0.5px;
        text-align: center;
    }

    .download-subtitle {
        color: #6b7280;
        margin-bottom: 32px;
        text-align: center;
        font-size: 16px;
    }

    .file-info {
        background: rgba(243, 244, 246, 0.6);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 32px;
    }

    .file-detail {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .file-detail:last-child {
        margin-bottom: 0;
    }

    .file-label {
        font-weight: 600;
        color: #6b7280;
        font-size: 14px;
    }

    .file-value {
        font-weight: 500;
        color: #1f2937;
        font-size: 14px;
        text-align: right;
        max-width: 200px;
        word-break: break-all;
    }

    .download-form {
        text-align: center;
    }

    .password-input {
        width: 100%;
        padding: 16px 20px;
        border: 2px solid rgba(209, 213, 219, 0.5);
        border-radius: 12px;
        font-size: 16px;
        background: rgba(255, 255, 255, 0.8);
        transition: all 0.2s ease;
        margin-bottom: 20px;
    }

    .password-input:focus {
        outline: none;
        border-color: #6366f1;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }

    .download-btn {
        width: 100%;
        padding: 16px 24px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

    .download-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(99, 102, 241, 0.4);
    }

    .download-btn:active {
        transform: translateY(0);
    }

    .security-notice {
        background: rgba(254, 243, 199, 0.8);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 12px;
        padding: 16px;
        margin-top: 24px;
        text-align: center;
    }

    .security-notice i {
        color: #f59e0b;
        margin-right: 8px;
    }

    .security-notice-text {
        color: #92400e;
        font-size: 14px;
        margin: 0;
    }
    
</style>

<div class="container-fluid">
    <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="col-12">
            <div class="download-container">
                <div class="file-icon-container">
                    @{
                        var extension = @Model.FileExtension;
                        var iconClass = extension switch
                        {
                            ".pdf" => "fas fa-file-pdf",
                            ".doc" or ".docx" => "fas fa-file-word",
                            ".xls" or ".xlsx" => "fas fa-file-excel",
                            ".jpg" or ".jpeg" or ".png" or ".gif" => "fas fa-file-image",
                            ".zip" or ".rar" => "fas fa-file-archive",
                            ".mp4" or ".avi" or ".mov" => "fas fa-file-video",
                            ".mp3" or ".wav" or ".flac" => "fas fa-file-audio",
                            _ => "fas fa-file"
                        };
                    }
                    <i class="@iconClass"></i>
                </div>

                <h1 class="download-title">Pobieranie pliku</h1>
                <p class="download-subtitle">Plik jest gotowy do pobrania</p>

                <div class="file-info">
                    <div class="file-detail">
                        <span class="file-label">Nazwa pliku:</span>
                        <span class="file-value" title="@Model.FileName">@Model.FileName</span>
                    </div>
                    <div class="file-detail">
                        <span class="file-label">Rozmiar:</span>
                        <span class="file-value">@Model.FileSize</span>
                    </div>
                    @if (Model.IsOneTime)
                    {
                        <div class="file-detail">
                            <span class="file-label">Typ dostępu:</span>
                            <span class="file-value text-warning">
                                <i class="fas fa-exclamation-triangle"></i> Jednorazowy
                            </span>
                        </div>
                    }
                </div>

                <form method="get" action="/share/@Model.Token/download" class="download-form">
                    @if (Model.IsRequiredPassword)
                    {
                        <input type="password" 
                               name="password" 
                               class="password-input" 
                               placeholder="Wprowadź hasło dostępu..." 
                               required />
                    }
                    
                    <button type="submit" class="download-btn">
                        <i class="fas fa-download me-2"></i>
                        Pobierz plik
                    </button>
                </form>

                @if (Model.IsOneTime)
                {
                    <div class="security-notice">
                        <i class="fas fa-shield-alt"></i>
                        <p class="security-notice-text">
                            <strong>Uwaga:</strong> Ten link działa tylko raz. Po pobraniu pliku link zostanie dezaktywowany.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelector('.download-form').addEventListener('submit', function(e) {
        const btn = document.querySelector('.download-btn');
        
        if (@Model.IsOneTime.ToString().ToLower() && btn.classList.contains('used')) {
            e.preventDefault();
            return;
        }

        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Pobieranie...';
        btn.disabled = true;
        
        if (@Model.IsOneTime.ToString().ToLower()) {
            setTimeout(() => {
                btn.innerHTML = '<i class="fas fa-times me-2"></i>Link wyczerpany';
                btn.classList.add('used');
                btn.disabled = true;
            }, 2000);
        } else {
            setTimeout(() => {
                btn.innerHTML = '<i class="fas fa-download me-2"></i>Pobierz plik';
                btn.disabled = false;
            }, 3000);
        }
    });
    
    @if (Model.IsRequiredPassword)
    {
        <text>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelector('.password-input').focus();
        });
        </text>
    }
</script>